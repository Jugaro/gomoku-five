rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validNickname(value) {
      return value is string
        && value.size() >= 3
        && value.size() <= 16
        && value.matches('^[A-Za-zА-Яа-яЁё0-9_-]+$');
    }

    function normalizedNickname(value) {
      return value.lower()
        .replace('А', 'а').replace('Б', 'б').replace('В', 'в')
        .replace('Г', 'г').replace('Д', 'д').replace('Е', 'е')
        .replace('Ё', 'ё').replace('Ж', 'ж').replace('З', 'з')
        .replace('И', 'и').replace('Й', 'й').replace('К', 'к')
        .replace('Л', 'л').replace('М', 'м').replace('Н', 'н')
        .replace('О', 'о').replace('П', 'п').replace('Р', 'р')
        .replace('С', 'с').replace('Т', 'т').replace('У', 'у')
        .replace('Ф', 'ф').replace('Х', 'х').replace('Ц', 'ц')
        .replace('Ч', 'ч').replace('Ш', 'ш').replace('Щ', 'щ')
        .replace('Ъ', 'ъ').replace('Ы', 'ы').replace('Ь', 'ь')
        .replace('Э', 'э').replace('Ю', 'ю').replace('Я', 'я');
    }

    function gameData(gameId) {
      return getAfter(/databases/$(database)/documents/games/$(gameId)).data;
    }

    function hasStone(moves, x, y, player) {
      return moves.hasAll([{'x': x, 'y': y, 'player': player}]);
    }

    function countDirection(moves, x, y, player, dx, dy) {
      return hasStone(moves, x + dx, y + dy, player)
        ? hasStone(moves, x + dx * 2, y + dy * 2, player)
          ? hasStone(moves, x + dx * 3, y + dy * 3, player)
            ? hasStone(moves, x + dx * 4, y + dy * 4, player) ? 4 : 3
            : 2
          : 1
        : 0;
    }

    function hasFiveInDirection(moves, x, y, player, dx, dy) {
      let positive = countDirection(moves, x, y, player, dx, dy);
      let negative = countDirection(moves, x, y, player, -dx, -dy);
      return positive + negative >= 4;
    }

    function hasFive(moves, x, y, player) {
      return hasFiveInDirection(moves, x, y, player, 1, 0)
        || hasFiveInDirection(moves, x, y, player, 0, 1)
        || hasFiveInDirection(moves, x, y, player, 1, 1)
        || hasFiveInDirection(moves, x, y, player, 1, -1);
    }

    function validGameCreate() {
      let data = request.resource.data;
      let players = data.players;
      return data.keys().hasOnly([
          'players', 'nicknames', 'moves', 'currentPlayer',
          'active', 'winner', 'version', 'createdAt', 'updatedAt'
        ])
        && players is list
        && players.size() == 2
        && players[0] is string
        && players[1] is string
        && players[0] != players[1]
        && players.hasAll([request.auth.uid])
        && data.nicknames is map
        && data.nicknames.keys().hasAll(players)
        && data.nicknames.keys().hasOnly(players)
        && validNickname(data.nicknames[players[0]])
        && validNickname(data.nicknames[players[1]])
        && data.moves == []
        && data.currentPlayer == 'black'
        && data.active == true
        && data.winner == null
        && data.version == 0;
    }

    function validMove() {
      let oldData = resource.data;
      let data = request.resource.data;
      let oldMoves = oldData.moves;
      let moves = data.moves;
      let move = moves[moves.size() - 1];
      let mover = oldData.currentPlayer;
      let won = hasFive(moves, move.x, move.y, mover);
      return data.keys().hasOnly([
          'players', 'nicknames', 'moves', 'currentPlayer',
          'active', 'winner', 'version', 'createdAt', 'updatedAt'
        ])
        && data.diff(oldData).affectedKeys().hasOnly([
          'moves', 'currentPlayer', 'active', 'winner', 'version', 'updatedAt'
        ])
        && oldData.active == true
        && oldData.winner == null
        && oldData.players.hasAll([request.auth.uid])
        && mover == (oldData.players[0] == request.auth.uid ? 'black' : 'white')
        && moves is list
        && moves.size() == oldMoves.size() + 1
        && move is map
        && move.keys().hasAll(['x', 'y', 'player'])
        && move.keys().hasOnly(['x', 'y', 'player'])
        && move.x is int
        && move.y is int
        && move.player == mover
        && !hasStone(oldMoves, move.x, move.y, 'black')
        && !hasStone(oldMoves, move.x, move.y, 'white')
        && moves == oldMoves.concat([move])
        && data.currentPlayer == (mover == 'black' ? 'white' : 'black')
        && data.version == oldData.version + 1
        && data.active == !won
        && data.winner == (won ? mover : null);
    }

    function validMatchedQueueUpdate(uid) {
      let oldData = resource.data;
      let data = request.resource.data;
      let game = gameData(data.gameId);
      return oldData.status == 'waiting'
        && data.status == 'matched'
        && data.gameId is string
        && data.gameId.size() > 0
        && data.diff(oldData).affectedKeys().hasOnly([
          'status', 'gameId', 'updatedAt', 'matchedAt'
        ])
        && data.get('uid', uid) == oldData.get('uid', uid)
        && game.players.size() == 2
        && game.players.hasAll([uid, request.auth.uid]);
    }

    function validWaitingQueueUpdate(uid) {
      let data = request.resource.data;
      return request.auth.uid == uid
        && resource.data.status == 'waiting'
        && data.status == 'waiting'
        && data.keys().hasOnly([
          'uid', 'nickname', 'status', 'gameId', 'createdAt', 'updatedAt'
        ])
        && data.get('uid', uid) == uid
        && validNickname(data.nickname)
        && data.get('gameId', null) == null
        && data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'nickname', 'gameId', 'updatedAt'
        ]);
    }

    function validQueueUpdate(uid) {
      return request.resource.data.status == 'matched'
        ? validMatchedQueueUpdate(uid)
        : validWaitingQueueUpdate(uid);
    }

    match /players/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nickname', 'nicknameLower', 'updatedAt'])
        && validNickname(request.resource.data.nickname)
        && request.resource.data.nicknameLower is string
        && request.resource.data.nicknameLower == normalizedNickname(
          request.resource.data.nickname
        );
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /queue/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid || resource.data.status == 'waiting');
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'nickname', 'status', 'gameId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.get('uid', uid) == uid
        && validNickname(request.resource.data.nickname)
        && request.resource.data.status == 'waiting'
        && request.resource.data.get('gameId', null) == null;
      allow update: if signedIn() && validQueueUpdate(uid);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /invitations/{invitationId} {
      allow read: if signedIn()
        && (
          request.auth.uid == resource.data.fromUid
          || request.auth.uid == resource.data.toUid
        );
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'fromUid', 'toUid', 'fromNickname', 'status', 'gameId',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid.size() > 0
        && request.resource.data.toUid != request.auth.uid
        && validNickname(request.resource.data.fromNickname)
        && request.resource.data.status == 'pending'
        && request.resource.data.get('gameId', null) == null;
      allow update: if signedIn()
        && request.auth.uid == resource.data.toUid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'gameId', 'updatedAt', 'respondedAt'
        ])
        && (
          (
            request.resource.data.status == 'declined'
            && request.resource.data.get('gameId', null) == null
          )
          ||
          (
            request.resource.data.status == 'accepted'
            && request.resource.data.gameId is string
            && request.resource.data.gameId.size() > 0
            && gameData(request.resource.data.gameId).players.size() == 2
            && gameData(request.resource.data.gameId).players.hasAll([
              resource.data.fromUid, resource.data.toUid
            ])
          )
        );
    }

    match /games/{gameId} {
      allow read: if signedIn()
        && resource.data.players.hasAll([request.auth.uid]);
      allow create: if signedIn() && validGameCreate();
      allow update: if signedIn() && validMove();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
